#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Block plaintext .env files BEFORE lint-staged (fail fast)
scripts/assert-no-plaintext-env.sh || exit 1

# Secret scanning on staged changes
gitleaks protect --staged --config .gitleaks.toml --redact || exit 1

# Linting + formatting
npx lint-staged
