{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/agent-role-codex.sh",
            "timeout": 5,
            "statusMessage": "Checking prompt for a lane-agent role assignment"
          }
        ]
      }
    ]
  }
}
