# =============================================================================
# Plaintext env files are FORBIDDEN (.claude/rules/secrets-hygiene.md).
# Only reference/documentation templates may be committed.
# =============================================================================
.env
.env.*
!.env.tpl
!.env.example
!.env.sample
!.env.template

# Local-only exception files (devcontainer/Codespace ephemeral dev).
# Ignored by policy — must never be committed. An ADR must exist under
# docs/decisions/ for any project that relies on one. If a project needs to
# carry an encrypted exception file in-repo, use sops (*.enc.yaml), not this.
.env.local.exception

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Dependencies (language-specific - uncomment as needed)
